  "font": {
    "family": {
      "ui":      { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
      "reading": { "$type": "fontFamily", "$value": ["Literata", "Georgia", "serif"], "$description": "note body and headings" },
      "mono":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "monospace"] }
    },
    "size": {
      "small":      { "$type": "dimension", "$value": "12px" },
      "body":       { "$type": "dimension", "$value": "14px" },
      "reading":    { "$type": "dimension", "$value": "17px" },
      "title":      { "$type": "dimension", "$value": "18px" },
      "heading":    { "$type": "dimension", "$value": "24px" },
      "note-title": { "$type": "dimension", "$value": "36px" }
    }
  },
  "spacing": {
    "xs": { "$type": "dimension", "$value": "2px" },
    "s":  { "$type": "dimension", "$value": "4px" },
    "m":  { "$type": "dimension", "$value": "8px" },
    "l":  { "$type": "dimension", "$value": "12px" },
    "xl": { "$type": "dimension", "$value": "20px" }
  },
  "radius": {
    "s": { "$type": "dimension", "$value": "4px" },
    "m": { "$type": "dimension", "$value": "6px" },
    "l": { "$type": "dimension", "$value": "10px" },
    "pill": { "$type": "dimension", "$value": "999px" }
