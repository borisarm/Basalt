<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Basalt.Presentation.Panels;assembly=Basalt.Presentation"
             xmlns:o="clr-namespace:Basalt.Presentation.Overlays;assembly=Basalt.Presentation"
             xmlns:s="clr-namespace:Basalt.Application.Search;assembly=Basalt.Application"
             xmlns:l="clr-namespace:Basalt.UI.Localization"
             x:Class="Basalt.UI.Views.BookmarksView"
             x:DataType="p:BookmarksViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" x:Name="Warning" Text="{Binding Warning}" IsVisible="{Binding Warning, Converter={x:Static ObjectConverters.IsNotNull}}"
               Foreground="{DynamicResource BasaltWarningBrush}" TextWrapping="Wrap" Margin="{StaticResource BasaltSpacingS}" />
    <TreeView x:Name="Tree" ItemsSource="{Binding Items}">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="p:BookmarkItemViewModel">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{l:Loc Bookmarks.Remove}" Command="{Binding RemoveCommand}"
                    CommandParameter="{Binding $parent[TreeView].SelectedItem}" />
        </ContextMenu>
      </TreeView.ContextMenu>
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="p:BookmarkItemViewModel" ItemsSource="{Binding Children}">
          <TextBlock Text="{Binding Title}" />
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
