<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:diff="clr-namespace:Basalt.Presentation.Diff;assembly=Basalt.Presentation"
             x:Class="Basalt.UI.Views.DiffView">
  <!-- Spec 07 §8: two aligned columns by hunks of LineDiff, with the kind highlighted per row. -->
  <UserControl.Styles>
    <Style Selector="Border.added">
      <Setter Property="Background" Value="{DynamicResource BasaltDiffAddedBrush}" />
    </Style>
    <Style Selector="Border.removed">
      <Setter Property="Background" Value="{DynamicResource BasaltDiffRemovedBrush}" />
    </Style>
    <Style Selector="Border.changed">
      <Setter Property="Background" Value="{DynamicResource BasaltDiffChangedBrush}" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Auto">
    <ItemsControl x:Name="Rows">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="diff:DiffLine">
          <Grid ColumnDefinitions="48,*,48,*">
            <Border Grid.Column="0" Classes.removed="{Binding IsRemoved}" Classes.changed="{Binding IsChanged}">
              <TextBlock Text="{Binding LeftNumber}" HorizontalAlignment="Right" Margin="0,0,6,0"
                         FontSize="{StaticResource BasaltFontSizeSmall}" Foreground="{DynamicResource BasaltTextMutedBrush}" />
            </Border>
            <Border Grid.Column="1" Classes.removed="{Binding IsRemoved}" Classes.changed="{Binding IsChanged}">
              <TextBlock Text="{Binding LeftText}" FontFamily="{StaticResource BasaltFontMono}" TextWrapping="NoWrap"
                         Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
            </Border>
            <Border Grid.Column="2" Classes.added="{Binding IsAdded}" Classes.changed="{Binding IsChanged}">
              <TextBlock Text="{Binding RightNumber}" HorizontalAlignment="Right" Margin="0,0,6,0"
                         FontSize="{StaticResource BasaltFontSizeSmall}" Foreground="{DynamicResource BasaltTextMutedBrush}" />
            </Border>
            <Border Grid.Column="3" Classes.added="{Binding IsAdded}" Classes.changed="{Binding IsChanged}">
              <TextBlock Text="{Binding RightText}" FontFamily="{StaticResource BasaltFontMono}" TextWrapping="NoWrap"
                         Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
            </Border>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </ScrollViewer>
</UserControl>
