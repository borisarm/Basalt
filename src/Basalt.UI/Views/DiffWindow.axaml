<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Basalt.UI.Views"
        xmlns:l="clr-namespace:Basalt.UI.Localization"
        x:Class="Basalt.UI.Views.DiffWindow"
        Width="900" Height="600" WindowStartupLocation="CenterOwner">
  <!-- Spec 07 §8: differences of the conflicting versions, aligned by hunks. -->
  <DockPanel Margin="{StaticResource BasaltSpacingM}">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" Margin="0,0,0,8">
      <TextBlock x:Name="LeftTitle" FontWeight="SemiBold" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
      <TextBlock x:Name="RightTitle" Grid.Column="1" FontWeight="SemiBold" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
    </Grid>
    <Button x:Name="CloseButton" DockPanel.Dock="Bottom" Content="{l:Loc Common.Close}" Click="OnClose"
            HorizontalAlignment="Right" Margin="0,8,0,0" IsCancel="True" />
    <views:DiffView x:Name="Diff" />
  </DockPanel>
</Window>
