<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Basalt.Presentation.Panels;assembly=Basalt.Presentation"
             xmlns:o="clr-namespace:Basalt.Presentation.Overlays;assembly=Basalt.Presentation"
             xmlns:s="clr-namespace:Basalt.Application.Search;assembly=Basalt.Application"
             xmlns:l="clr-namespace:Basalt.UI.Localization"
             x:Class="Basalt.UI.Views.FileExplorerView"
             x:DataType="p:FileExplorerViewModel">
  <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="8,4,2,2">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
        <Button x:Name="NewNote" Classes="icon small" Command="{Binding NewNoteCommand}" CommandParameter="{Binding Selected}"
                AutomationProperties.Name="{l:Loc Commands.NewNote}" ToolTip.Tip="{l:Loc Commands.NewNote}" ><PathIcon Width="14" Height="14" Data="{StaticResource IconAdd}" /></Button>
        <Button x:Name="NewFolder" Classes="icon small" Command="{Binding NewFolderCommand}" CommandParameter="{Binding Selected}"
                AutomationProperties.Name="{l:Loc Explorer.NewFolder}" ToolTip.Tip="{l:Loc Explorer.NewFolder}" ><PathIcon Width="14" Height="14" Data="{StaticResource IconFolderAdd}" /></Button>
        <Button x:Name="Refresh" Classes="icon small" Command="{Binding RefreshCommand}"
                AutomationProperties.Name="{l:Loc Panel.Refresh}" ToolTip.Tip="{l:Loc Panel.Refresh}" ><PathIcon Width="14" Height="14" Data="{StaticResource IconRefresh}" /></Button>
      </StackPanel>
      <TextBlock Classes="caption" Text="{l:Loc Panel.files}" VerticalAlignment="Center" />
    </DockPanel>
    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" SelectedItem="{Binding Selected}"
              AutomationProperties.Name="{l:Loc Panel.files}">
      <TreeView.Styles>
        <Style Selector="TreeViewItem" x:DataType="p:FileTreeNodeViewModel">
          <Setter Property="IsExpanded" Value="{Binding IsExpanded}" />
        </Style>
      </TreeView.Styles>
      <TreeView.ContextMenu>
        <ContextMenu>
          <MenuItem Header="{l:Loc Commands.NewNote}" Command="{Binding NewNoteCommand}" CommandParameter="{Binding Selected}" />
          <MenuItem Header="{l:Loc Explorer.NewFolder}" Command="{Binding NewFolderCommand}" CommandParameter="{Binding Selected}" />
          <MenuItem Header="{l:Loc Explorer.Rename}" Command="{Binding RenameCommand}" CommandParameter="{Binding Selected}" />
          <MenuItem Header="{l:Loc Explorer.Delete}" Command="{Binding DeleteCommand}" CommandParameter="{Binding Selected}" />
        </ContextMenu>
      </TreeView.ContextMenu>
      <TreeView.ItemTemplate>
        <TreeDataTemplate x:DataType="p:FileTreeNodeViewModel" ItemsSource="{Binding Children}">
          <TextBlock Text="{Binding Name}" />
        </TreeDataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>
  </DockPanel>
</UserControl>
