<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sync="clr-namespace:Basalt.Presentation.Sync;assembly=Basalt.Presentation"
             xmlns:remote="clr-namespace:Basalt.Application.Ports.Remote;assembly=Basalt.Application"
             xmlns:views="clr-namespace:Basalt.UI.Views"
             xmlns:l="clr-namespace:Basalt.UI.Localization"
             x:Class="Basalt.UI.Views.FileHistoryView"
             x:DataType="sync:FileHistoryViewModel">
  <!-- Spec 04 F-015.7: commits that changed the note, the diff with the selected version and restore. -->
  <Grid ColumnDefinitions="360,*" Margin="{StaticResource BasaltSpacingM}">
    <DockPanel Grid.Column="0" Margin="0,0,12,0">
      <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontWeight="SemiBold"
                 Foreground="{DynamicResource BasaltTextPrimaryBrush}" Margin="0,0,0,8" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button x:Name="PreviewButton" Content="{l:Loc Sync.Preview}" Command="{Binding PreviewCommand}" />
        <Button x:Name="RestoreButton" Content="{l:Loc Sync.Restore}" Command="{Binding RestoreCommand}" />
      </StackPanel>
      <ListBox x:Name="CommitsList" ItemsSource="{Binding Commits}" SelectedItem="{Binding Selected}" Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="remote:RemoteCommitInfo">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Message}" Foreground="{DynamicResource BasaltTextPrimaryBrush}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding AuthorName}" FontSize="{StaticResource BasaltFontSizeSmall}"
                         Foreground="{DynamicResource BasaltTextMutedBrush}" />
              <TextBlock Text="{Binding When}" FontSize="{StaticResource BasaltFontSizeSmall}"
                         Foreground="{DynamicResource BasaltTextMutedBrush}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    <DockPanel Grid.Column="1">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="24" Margin="0,0,0,6">
        <TextBlock Text="{l:Loc Sync.CurrentVersion}" FontWeight="SemiBold" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
        <TextBlock Text="{l:Loc Sync.SelectedVersion}" FontWeight="SemiBold" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
      </StackPanel>
      <views:DiffView x:Name="HistoryDiff" Document="{Binding DiffRows}" />
    </DockPanel>
  </Grid>
</UserControl>
