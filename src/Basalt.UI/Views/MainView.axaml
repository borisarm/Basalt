<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:Basalt.Presentation.Shell;assembly=Basalt.Presentation"
             xmlns:common="clr-namespace:Basalt.Presentation.Common;assembly=Basalt.Presentation"
             xmlns:views="clr-namespace:Basalt.UI.Views"
             x:Class="Basalt.UI.Views.MainView"
             x:DataType="shell:ShellViewModel"
             TopLevel.AutoSafeAreaPadding="True">
  <!-- Spec 07 §4: single-view root. T10.2 replaces the desktop-style content with the iPhone/iPad navigation. -->
  <Panel Background="{DynamicResource BasaltBackgroundBrush}">
    <views:MobileShellView />
    <ItemsControl x:Name="Toasts" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{StaticResource BasaltSpacingXl}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="common:Notification">
          <Border Background="{DynamicResource BasaltSurfaceAltBrush}" BorderBrush="{DynamicResource BasaltBorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource BasaltRadiusM}" Padding="{StaticResource BasaltSpacingL}"
                  Margin="{StaticResource BasaltSpacingS}" MaxWidth="420">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Panel>
</UserControl>
