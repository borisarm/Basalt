<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Basalt.Presentation.Shell;assembly=Basalt.Presentation"
        xmlns:common="clr-namespace:Basalt.Presentation.Common;assembly=Basalt.Presentation"
        xmlns:ui="clr-namespace:Basalt.UI"
        xmlns:l="clr-namespace:Basalt.UI.Localization"
        x:Class="Basalt.UI.Views.MainWindow"
        x:DataType="shell:ShellViewModel"
        Title="{Binding Title}"
        Width="1280" Height="800" MinWidth="640" MinHeight="400"
        Background="{DynamicResource BasaltBackgroundBrush}">
  <!-- Native menu bar on macOS (and menu in the window elsewhere when shown). -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="{l:Loc Menu.File}">
        <NativeMenu>
          <NativeMenuItem Header="{l:Loc Menu.NewWindow}" Command="{Binding NewWindowCommand}" Gesture="Ctrl+Shift+N" />
          <NativeMenuItem Header="{l:Loc Menu.CloseVault}" Command="{Binding CloseVaultCommand}" />
        </NativeMenu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>
  <Window.DataTemplates>
    <ui:ViewLocator />
  </Window.DataTemplates>
  <Panel>
    <ContentControl Content="{Binding Content}" />
    <ItemsControl x:Name="Toasts" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{StaticResource BasaltSpacingXl}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="common:Notification">
          <Border Background="{DynamicResource BasaltSurfaceAltBrush}" BorderBrush="{DynamicResource BasaltBorderBrush}"
                  BorderThickness="1" CornerRadius="{StaticResource BasaltRadiusM}" Padding="{StaticResource BasaltSpacingL}"
                  Margin="{StaticResource BasaltSpacingS}" MaxWidth="420">
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Panel>
</Window>
