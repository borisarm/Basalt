<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Basalt.Presentation.Panels;assembly=Basalt.Presentation"
             xmlns:o="clr-namespace:Basalt.Presentation.Overlays;assembly=Basalt.Presentation"
             xmlns:s="clr-namespace:Basalt.Application.Search;assembly=Basalt.Application"
             xmlns:l="clr-namespace:Basalt.UI.Localization"
             x:Class="Basalt.UI.Views.QuickSwitcherView"
             x:DataType="o:QuickSwitcherViewModel">
  <Border Classes="overlay" Width="620" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,72,0,0">
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="18,8,14,8">
        <Border DockPanel.Dock="Right" Classes="kbd"><TextBlock Text="{l:Loc Overlay.EscKey}" /></Border>
        <PathIcon DockPanel.Dock="Left" Width="16" Height="16" Data="{StaticResource IconSearch}" Foreground="{DynamicResource BasaltTextMutedBrush}" />
        <TextBox x:Name="Input" Classes="bare" Margin="10,0" Text="{Binding Text}" PlaceholderText="{l:Loc QuickSwitcher.Placeholder}" AutomationProperties.Name="{l:Loc QuickSwitcher.Placeholder}" />
      </DockPanel>
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BasaltBorderBrush}" BorderThickness="0,1,0,0" Padding="18,8">
        <StackPanel Orientation="Horizontal" Spacing="18">
          <TextBlock Classes="muted" Text="{l:Loc Overlay.HintNavigate}" />
          <TextBlock Classes="muted" Text="{l:Loc Overlay.HintOpen}" />
          <TextBlock Classes="muted" Text="{l:Loc Overlay.HintNewTab}" />
          <TextBlock Classes="muted" Text="{l:Loc Overlay.HintCreate}" />
        </StackPanel>
      </Border>
      <Border BorderBrush="{DynamicResource BasaltBorderBrush}" BorderThickness="0,1,0,0" Padding="8">
        <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedIndex="{Binding SelectedIndex, Mode=OneWay}" MaxHeight="380"
                 AutomationProperties.Name="{l:Loc Menu.QuickSwitcher}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="s:QuickSwitchItem">
              <DockPanel>
                <PathIcon DockPanel.Dock="Left" Width="15" Height="15" Margin="2,2,12,0" VerticalAlignment="Top"
                          Data="{StaticResource IconNote}" Foreground="{DynamicResource BasaltTextMutedBrush}" />
                <StackPanel Spacing="1">
                  <TextBlock Text="{Binding Display}" />
                  <TextBlock Text="{Binding Path, FallbackValue=''}" Classes="muted" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
    </DockPanel>
  </Border>
</UserControl>
