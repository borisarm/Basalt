<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Basalt.Presentation.Panels;assembly=Basalt.Presentation"
             xmlns:o="clr-namespace:Basalt.Presentation.Overlays;assembly=Basalt.Presentation"
             xmlns:s="clr-namespace:Basalt.Application.Search;assembly=Basalt.Application"
             xmlns:l="clr-namespace:Basalt.UI.Localization"
             x:Class="Basalt.UI.Views.QuickSwitcherView"
             x:DataType="o:QuickSwitcherViewModel">
  <Border Classes="overlay" Width="560" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,80,0,0" Padding="14"
          Background="{DynamicResource BasaltSurfaceBrush}" BorderBrush="{DynamicResource BasaltBorderBrush}" BorderThickness="1" CornerRadius="12"
          BoxShadow="0 18 48 0 #33000000">
    <DockPanel>
      <TextBox DockPanel.Dock="Top" x:Name="Input" Text="{Binding Text}" PlaceholderText="{l:Loc QuickSwitcher.Placeholder}" AutomationProperties.Name="{l:Loc QuickSwitcher.Placeholder}" />
      <ListBox x:Name="List" ItemsSource="{Binding Items}" SelectedIndex="{Binding SelectedIndex, Mode=OneWay}" MaxHeight="360" Margin="0,8,0,0"
               AutomationProperties.Name="{l:Loc Menu.QuickSwitcher}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="s:QuickSwitchItem">
            <StackPanel>
              <TextBlock Text="{Binding Display}" />
              <TextBlock Text="{Binding Path, FallbackValue=''}" FontSize="{StaticResource BasaltFontSizeSmall}" Foreground="{DynamicResource BasaltTextMutedBrush}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Border>
</UserControl>
