<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
             xmlns:settings="clr-namespace:Basalt.Presentation.Settings;assembly=Basalt.Presentation"
             xmlns:l="clr-namespace:Basalt.UI.Localization"
             x:Class="Basalt.UI.Views.SettingsView"
             x:DataType="settings:SettingsViewModel">
  <!-- Spec 04 F-014: settings sections; every change applies and is saved immediately. -->
  <ScrollViewer x:Name="Scroll">
    <StackPanel Margin="{StaticResource BasaltSpacingXl}" Spacing="{StaticResource BasaltSpacingXl}" MaxWidth="760" HorizontalAlignment="Left">
      <StackPanel Spacing="{StaticResource BasaltSpacingM}">
        <TextBlock x:Name="GeneralHeader" Text="{l:Loc Settings.General}" FontSize="{StaticResource BasaltFontSizeTitle}"
                   FontWeight="SemiBold" Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="{StaticResource BasaltSpacingS}">
          <TextBlock Text="{l:Loc Settings.General.Language}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <ComboBox Grid.Column="1" x:Name="Language" SelectionChanged="OnLanguageChanged">
            <ComboBoxItem Content="{l:Loc Settings.General.System}" />
            <ComboBoxItem Content="{l:Loc Settings.General.English}" />
            <ComboBoxItem Content="{l:Loc Settings.General.Spanish}" />
          </ComboBox>
          <CheckBox Grid.Row="1" Grid.Column="1" x:Name="OpenLastVault" Content="{l:Loc Settings.General.OpenLastVault}"
                    Click="OnOpenLastVaultChanged" />
        </Grid>
      </StackPanel>

      <StackPanel Spacing="{StaticResource BasaltSpacingM}">
        <TextBlock x:Name="EditorHeader" Text="{l:Loc Settings.Editor}" FontSize="{StaticResource BasaltFontSizeTitle}"
                   FontWeight="SemiBold" Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource BasaltSpacingS}">
          <TextBlock Text="{l:Loc Settings.Editor.FontFamily}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <TextBox Grid.Column="1" x:Name="FontFamilyBox" Text="{Binding Editor.Settings.FontFamily}" LostFocus="OnEditorLostFocus" />

          <TextBlock Grid.Row="1" Text="{l:Loc Settings.Editor.FontSize}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="FontSizeBox" Width="100" HorizontalAlignment="Left"
                   Text="{Binding Editor.Settings.FontSize}" LostFocus="OnEditorLostFocus" />

          <CheckBox Grid.Row="2" Grid.Column="1" x:Name="ReadableLineLength" Content="{l:Loc Settings.Editor.ReadableLineLength}"
                    IsChecked="{Binding Editor.Settings.ReadableLineLength}" Click="OnEditorToggle" />
          <CheckBox Grid.Row="3" Grid.Column="1" x:Name="ShowLineNumbers" Content="{l:Loc Settings.Editor.ShowLineNumbers}"
                    IsChecked="{Binding Editor.Settings.ShowLineNumbers}" Click="OnEditorToggle" />
          <CheckBox Grid.Row="4" Grid.Column="1" x:Name="WordWrap" Content="{l:Loc Settings.Editor.WordWrap}"
                    IsChecked="{Binding Editor.Settings.WordWrap}" Click="OnEditorToggle" />
          <CheckBox Grid.Row="5" Grid.Column="1" x:Name="SpellCheck" Content="{l:Loc Settings.Editor.SpellCheck}"
                    IsChecked="{Binding Editor.Settings.SpellCheck}" Click="OnEditorToggle" />
          <CheckBox Grid.Row="6" Grid.Column="1" x:Name="AutoPairBrackets" Content="{l:Loc Settings.Editor.AutoPairBrackets}"
                    IsChecked="{Binding Editor.Settings.AutoPairBrackets}" Click="OnEditorToggle" />
        </Grid>
      </StackPanel>

      <StackPanel x:Name="FilesAndLinksSection" Spacing="{StaticResource BasaltSpacingM}"
                  IsVisible="{Binding FilesAndLinks, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
        <TextBlock Text="{l:Loc Settings.FilesAndLinks}" FontSize="{StaticResource BasaltFontSizeTitle}"
                   FontWeight="SemiBold" Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="{StaticResource BasaltSpacingS}">
          <TextBlock Text="{l:Loc Settings.FilesLinks.AttachmentFolder}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <TextBox Grid.Column="1" x:Name="AttachmentFolder" Text="{Binding FilesAndLinks.Settings.AttachmentFolder}" LostFocus="OnVaultFoldersLostFocus" />

          <TextBlock Grid.Row="1" Text="{l:Loc Settings.FilesLinks.NewNoteFolder}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="NewNoteFolder" Text="{Binding FilesAndLinks.Settings.NewNoteFolder}" LostFocus="OnVaultFoldersLostFocus" />

          <TextBlock Grid.Row="2" Text="{l:Loc Settings.FilesLinks.LinkFormat}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <ComboBox Grid.Row="2" Grid.Column="1" x:Name="LinkFormatBox" HorizontalAlignment="Left" SelectionChanged="OnLinkFormatChanged">
            <ComboBoxItem Content="{l:Loc Settings.LinkFormat.Wikilink}" />
            <ComboBoxItem Content="{l:Loc Settings.LinkFormat.Markdown}" />
          </ComboBox>

          <TextBlock Grid.Row="3" Text="{l:Loc Settings.FilesLinks.LinkPathStyle}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <ComboBox Grid.Row="3" Grid.Column="1" x:Name="LinkPathStyleBox" HorizontalAlignment="Left" SelectionChanged="OnLinkPathStyleChanged">
            <ComboBoxItem Content="{l:Loc Settings.LinkPathStyle.Shortest}" />
            <ComboBoxItem Content="{l:Loc Settings.LinkPathStyle.Relative}" />
            <ComboBoxItem Content="{l:Loc Settings.LinkPathStyle.Absolute}" />
          </ComboBox>

          <CheckBox Grid.Row="4" Grid.Column="1" x:Name="AutoUpdateLinks" Content="{l:Loc Settings.FilesLinks.AutoUpdateLinks}"
                    IsChecked="{Binding FilesAndLinks.Settings.AutoUpdateLinks}" Click="OnAutoUpdateLinksChanged" />
        </Grid>
      </StackPanel>

      <StackPanel Spacing="{StaticResource BasaltSpacingM}">
        <TextBlock x:Name="AppearanceHeader" Text="{l:Loc Settings.Appearance}" FontSize="{StaticResource BasaltFontSizeTitle}"
                   FontWeight="SemiBold" Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource BasaltSpacingS}">
          <TextBlock Text="{l:Loc Settings.Appearance.Theme}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <ComboBox Grid.Column="1" x:Name="ThemeBox" HorizontalAlignment="Left" SelectionChanged="OnThemeChanged">
            <ComboBoxItem Content="{l:Loc Settings.Appearance.ThemeSystem}" />
            <ComboBoxItem Content="{l:Loc Settings.Appearance.ThemeLight}" />
            <ComboBoxItem Content="{l:Loc Settings.Appearance.ThemeDark}" />
          </ComboBox>

          <TextBlock Grid.Row="1" Text="{l:Loc Settings.Appearance.Accent}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="AccentColor" Width="140" HorizontalAlignment="Left"
                   Text="{Binding Appearance.AccentColor}" LostFocus="OnAppearanceLostFocus" />

          <TextBlock Grid.Row="2" Text="{l:Loc Settings.Appearance.InterfaceFontSize}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <TextBox Grid.Row="2" Grid.Column="1" x:Name="InterfaceFontSize" Width="100" HorizontalAlignment="Left"
                   Text="{Binding Appearance.InterfaceFontSize}" LostFocus="OnAppearanceLostFocus" />
        </Grid>
      </StackPanel>

      <StackPanel x:Name="HotkeysSection" Spacing="{StaticResource BasaltSpacingM}">
        <TextBlock x:Name="HotkeysHeader" Text="{l:Loc Settings.Hotkeys}" FontSize="{StaticResource BasaltFontSizeTitle}"
                   FontWeight="SemiBold" Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
        <ListBox x:Name="HotkeysList" ItemsSource="{Binding Hotkeys.Rows}" MaxHeight="320"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="settings:HotkeyRow">
              <Grid ColumnDefinitions="*,200,90,90" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource BasaltSpacingS}">
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
                <TextBox Grid.Column="1" x:Name="GestureBox" Text="{Binding Gesture, Mode=OneWay}" />
                <Button Grid.Column="2" Content="{l:Loc Settings.Hotkeys.Assign}" Click="OnAssignHotkey" />
                <Button Grid.Column="3" Content="{l:Loc Settings.Hotkeys.Reset}" Click="OnResetHotkey"
                        IsEnabled="{Binding IsCustom}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{l:Loc Settings.Hotkeys.Conflict}"
                           IsVisible="{Binding HasConflict}" FontSize="{StaticResource BasaltFontSizeSmall}"
                           Foreground="{DynamicResource BasaltWarningBrush}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>

      <StackPanel x:Name="DailyNotesSection" Spacing="{StaticResource BasaltSpacingM}"
                  IsVisible="{Binding DailyNotes, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
        <TextBlock Text="{l:Loc Settings.DailyNotes}" FontSize="{StaticResource BasaltFontSizeTitle}"
                   FontWeight="SemiBold" Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="{StaticResource BasaltSpacingS}">
          <TextBlock Text="{l:Loc Settings.DailyNotes.Folder}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <TextBox Grid.Column="1" x:Name="DailyFolder" Text="{Binding DailyNotes.Settings.Folder}" LostFocus="OnDailyNotesLostFocus" />

          <TextBlock Grid.Row="1" Text="{l:Loc Settings.DailyNotes.DateFormat}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="DailyDateFormat" Text="{Binding DailyNotes.Settings.DateFormat}" LostFocus="OnDailyNotesLostFocus" />

          <TextBlock Grid.Row="2" Text="{l:Loc Settings.DailyNotes.Template}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <TextBox Grid.Row="2" Grid.Column="1" x:Name="DailyTemplate" Text="{Binding DailyNotes.Settings.TemplatePath}" LostFocus="OnDailyNotesLostFocus" />

          <TextBlock Grid.Row="3" Text="{l:Loc Settings.DailyNotes.Preview}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <TextBlock Grid.Row="3" Grid.Column="1" x:Name="DailyPreview" Text="{Binding DailyNotes.Preview}"
                     Foreground="{DynamicResource BasaltTextMutedBrush}" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>

      <StackPanel x:Name="TemplatesSection" Spacing="{StaticResource BasaltSpacingM}"
                  IsVisible="{Binding Templates, Converter={x:Static converters:ObjectConverters.IsNotNull}}">
        <TextBlock Text="{l:Loc Settings.Templates}" FontSize="{StaticResource BasaltFontSizeTitle}"
                   FontWeight="SemiBold" Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
        <Grid ColumnDefinitions="220,*">
          <TextBlock Text="{l:Loc Settings.Templates.Folder}" VerticalAlignment="Center" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <TextBox Grid.Column="1" x:Name="TemplatesFolder" Text="{Binding Templates.Folder}" LostFocus="OnTemplatesFolderLostFocus" />
        </Grid>
      </StackPanel>

      <StackPanel Spacing="{StaticResource BasaltSpacingM}">
        <TextBlock x:Name="AboutHeader" Text="{l:Loc Settings.About}" FontSize="{StaticResource BasaltFontSizeTitle}"
                   FontWeight="SemiBold" Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
        <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="{StaticResource BasaltSpacingS}">
          <TextBlock Text="{l:Loc Settings.About.Version}" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <TextBlock Grid.Column="1" Text="{Binding About.Version}" Foreground="{DynamicResource BasaltTextPrimaryBrush}" />

          <TextBlock Grid.Row="1" Text="{l:Loc Settings.About.Logs}" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding About.LogsDirectory}" TextWrapping="Wrap"
                     Foreground="{DynamicResource BasaltTextPrimaryBrush}" />

          <TextBlock Grid.Row="2" Text="{l:Loc Settings.About.Licenses}" Foreground="{DynamicResource BasaltTextSecondaryBrush}" />
          <ItemsControl Grid.Row="2" Grid.Column="1" ItemsSource="{Binding About.Licenses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" Foreground="{DynamicResource BasaltTextMutedBrush}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
