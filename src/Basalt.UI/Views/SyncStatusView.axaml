<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sync="clr-namespace:Basalt.Presentation.Sync;assembly=Basalt.Presentation"
             xmlns:l="clr-namespace:Basalt.UI.Localization"
             x:Class="Basalt.UI.Views.SyncStatusView"
             x:DataType="sync:SyncStatusViewModel">
  <!-- Spec 07 §8 and F-015.4: per-vault state in the status bar with the sync actions. -->
  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <TextBlock x:Name="SummaryText" Text="{Binding Summary}" VerticalAlignment="Center"
               Foreground="{DynamicResource BasaltTextMutedBrush}" />
    <Button x:Name="SyncNowButton" Content="{l:Loc Sync.SyncNow}" Command="{Binding SyncNowCommand}"
            AutomationProperties.Name="{l:Loc Sync.SyncNow}" ToolTip.Tip="{l:Loc Sync.SyncNow}" />
    <Button x:Name="PauseButton" Content="{l:Loc Sync.Pause}" Command="{Binding PauseCommand}"
            IsVisible="{Binding !IsPaused}" IsEnabled="{Binding IsConfigured}"
            AutomationProperties.Name="{l:Loc Sync.Pause}" ToolTip.Tip="{l:Loc Sync.Pause}" />
    <Button x:Name="ResumeButton" Content="{l:Loc Sync.Resume}" Command="{Binding ResumeCommand}"
            IsVisible="{Binding IsPaused}"
            AutomationProperties.Name="{l:Loc Sync.Resume}" ToolTip.Tip="{l:Loc Sync.Resume}" />
    <TextBlock x:Name="ConflictText" Text="{Binding ConflictSummary}" IsVisible="{Binding HasConflicts}"
               VerticalAlignment="Center" Foreground="{DynamicResource BasaltWarningBrush}" />
  </StackPanel>
</UserControl>
