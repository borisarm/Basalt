<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="clr-namespace:Basalt.Presentation.Panels;assembly=Basalt.Presentation"
             xmlns:o="clr-namespace:Basalt.Presentation.Overlays;assembly=Basalt.Presentation"
             xmlns:s="clr-namespace:Basalt.Application.Search;assembly=Basalt.Application"
             xmlns:l="clr-namespace:Basalt.UI.Localization"
             x:Class="Basalt.UI.Views.TagsPanelView"
             x:DataType="p:TagsPanelViewModel">
  <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" AutomationProperties.Name="{l:Loc Panel.tags}">
    <TreeView.ItemTemplate>
      <TreeDataTemplate x:DataType="p:TagNodeViewModel" ItemsSource="{Binding Children}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Margin="8,0,0,0" Foreground="{DynamicResource BasaltTextMutedBrush}" />
          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BasaltTagBrush}" />
        </DockPanel>
      </TreeDataTemplate>
    </TreeView.ItemTemplate>
  </TreeView>
</UserControl>
