<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Basalt.Presentation.Vaults;assembly=Basalt.Presentation"
             xmlns:l="clr-namespace:Basalt.UI.Localization"
             xmlns:ui="clr-namespace:Basalt.UI"
             x:Class="Basalt.UI.Views.VaultPickerView"
             x:DataType="vm:VaultPickerViewModel"
             Background="{DynamicResource BasaltBackgroundBrush}">
  <!-- F-001: the start screen. -->
  <Grid>
    <Border MaxWidth="640" Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Center"
            Background="{DynamicResource BasaltSurfaceBrush}" BorderBrush="{DynamicResource BasaltBorderBrush}"
            BorderThickness="1" CornerRadius="16" Padding="36">
      <StackPanel Spacing="24">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <Border Width="50" Height="50" CornerRadius="13" Background="{DynamicResource BasaltAccentBrush}">
            <PathIcon Width="26" Height="26" Data="{StaticResource IconNote}"
                      Foreground="{DynamicResource BasaltOnAccentBrush}"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{l:Loc VaultPicker.Title}" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
            <TextBlock Text="{l:Loc VaultPicker.Subtitle}" FontSize="13"
                       Foreground="{DynamicResource BasaltTextMutedBrush}" />
          </StackPanel>
        </StackPanel>

        <Border Background="{DynamicResource BasaltBackgroundBrush}" BorderBrush="{DynamicResource BasaltBorderBrush}"
                BorderThickness="1" CornerRadius="{StaticResource BasaltRadiusL}" Padding="6" MinHeight="240">
          <Panel>
            <TextBlock x:Name="EmptyText" Text="{l:Loc VaultPicker.Empty}" IsVisible="{Binding IsEmpty}"
                       Foreground="{DynamicResource BasaltTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <ListBox x:Name="VaultList" ItemsSource="{Binding Vaults}" Background="Transparent"
                     AutomationProperties.Name="{l:Loc VaultPicker.Title}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:VaultItemViewModel">
                  <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="2,4">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource BasaltRadiusL}"
                            Background="{Binding Name, Converter={x:Static ui:Converters.AvatarBrush}}">
                      <TextBlock Text="{Binding Name, Converter={x:Static ui:Converters.Initial}}" FontSize="17" FontWeight="Bold"
                                 Foreground="{DynamicResource BasaltOnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" Margin="14,0,0,0">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"
                                 Foreground="{DynamicResource BasaltTextPrimaryBrush}" />
                      <TextBlock Text="{Binding Location}" Classes="muted" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="quiet" Content="{l:Loc VaultPicker.Open}" Margin="8,0,0,0" VerticalAlignment="Center"
                            Command="{Binding $parent[ListBox].((vm:VaultPickerViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}" />
                    <Button Grid.Column="3" Classes="subtle" Content="{l:Loc VaultPicker.Remove}" Margin="4,0,0,0" VerticalAlignment="Center"
                            Command="{Binding $parent[ListBox].((vm:VaultPickerViewModel)DataContext).RemoveCommand}" CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Panel>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button x:Name="OpenFolderButton" Content="{l:Loc VaultPicker.OpenFolder}" Command="{Binding OpenFolderCommand}" />
          <Button x:Name="CreateButton" Content="{l:Loc VaultPicker.Create}" Command="{Binding CreateVaultCommand}" Classes="accent" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
