<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Basalt.iOS</RootNamespace>
    <AssemblyName>Basalt.iOS</AssemblyName>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <ApplicationId>net.basalt.app</ApplicationId>
    <ApplicationTitle>Basalt</ApplicationTitle>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Basalt.Composition/Basalt.Composition.csproj" />
    <ProjectReference Include="../Basalt.UI/Basalt.UI.csproj" />
    <ProjectReference Include="../Basalt.Adapters.Platform.Apple/Basalt.Adapters.Platform.Apple.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" />
    <PackageReference Include="SkiaSharp.NativeAssets.iOS" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
</Project>
